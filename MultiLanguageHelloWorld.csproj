<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Python\printer.py"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude the nested unit test project from compilation -->
  <ItemGroup>
    <Compile Remove="MultiLanguageHelloWorld.Tests/**/*.cs" />
    <EmbeddedResource Remove="MultiLanguageHelloWorld.Tests/**/*" />
    <None Remove="MultiLanguageHelloWorld.Tests/**/*" />
  </ItemGroup>

</Project>
